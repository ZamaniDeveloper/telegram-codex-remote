CONNECTOR_SECRET=
CONNECTOR_SSH_HOST=server.example.com
CONNECTOR_SSH_USER=codexbridge
CONNECTOR_SSH_PORT=22
CONNECTOR_PORT=27842
CONNECTOR_REMOTE_PORT=27841
# Reopen Codex automatically when closed (default: 1). Requires Windows logon.
# CONNECTOR_AUTO_START_CODEX=1
# Optional overrides; relative paths resolve against the project root.
# CONNECTOR_SSH_BIN=ssh.exe
# CONNECTOR_SSH_KEY=data/connector_ssh_key
# CONNECTOR_KNOWN_HOSTS=data/connector_known_hosts
# CODEX_QUOTA_BIN=C:/path/to/codex.exe

# Local Whisper (optional; install-whisper.ps1 uses these defaults).
# WHISPER_PYTHON=C:/TeleCodex/data/whisper-venv/Scripts/python.exe
# WHISPER_MODEL_PATH=C:/TeleCodex/data/whisper-model
# WHISPER_LANGUAGE=
# TELECODEX_PROJECT_ROOT=C:/Users/YourName/Documents/TeleCodex Projects
