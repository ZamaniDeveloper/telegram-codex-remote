TELEGRAM_BOT_TOKEN=
# Optional: numeric Telegram user ID. Otherwise pair with the code shown locally.
TELEGRAM_OWNER_ID=
# Local Windows mode: reopen closed Codex automatically (default: 1).
# CONNECTOR_AUTO_START_CODEX=1
# Server mode only: forwarded loopback endpoint + same secret as Windows connector.
# CONNECTOR_URL=http://127.0.0.1:27841
# CONNECTOR_SECRET=
# Node 24 HTTP proxy support, if Telegram is blocked on this computer:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
